        "table": { "__rl": true, "value": "AgentRuns", "mode": "list", "cachedResultName": "AgentRuns" },
        "filterByFormula": "AND({agent_name}='DEDUPLICATION', IS_SAME({timestamp}, TODAY(), 'day'))",
        "returnAll": true,
        "options": {}
      },
