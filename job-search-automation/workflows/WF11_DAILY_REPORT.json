    {
      "parameters": {
        "jsCode": "const dedup = $('Get_Dedup_Events_Today').all().map(i => i.json.fields);\nconst analyzer = $('Get_Analyzer_Runs_Today').all().map(i => i.json.fields);\nconst cvVersions = $('Get_CV_Versions_Today').all();\nconst applicationsSent = $('Get_Applications_Sent_Today').all().map(i => i.json.fields);\nconst statusChanges = $('Get_Status_Changes_Today').all().map(i => i.json.fields);\nconst topJobs = $('Get_Top_Jobs_Today').all().map(i => i.json.fields);\n\nconst count = (arr, pred) => arr.filter(pred).length;\n\nconst metrics = {\n  jobs_found: dedup.length,\n  jobs_new: count(dedup, d => d.decision === 'NEW' || d.decision === 'UPDATED_JOB'),\n  jobs_duplicate: count(dedup, d => d.decision === 'DUPLICATE' || d.decision === 'ALREADY_APPLIED'),\n  jobs_analyzed: analyzer.length,\n  jobs_score_80plus: count(analyzer, a => (a.score || 0) >= 80),\n  jobs_score_70_79: count(analyzer, a => (a.score || 0) >= 70 && (a.score || 0) < 80),\n  jobs_score_60_69: count(analyzer, a => (a.score || 0) >= 60 && (a.score || 0) < 70),\n  jobs_rejected: count(analyzer, a => a.decision === 'REJECT'),\n  cvs_generated: cvVersions.length,\n  applications_sent: count(applicationsSent, a => a.status === 'APPLIED' || a.status === 'APPLICATION_CONFIRMED'),\n  applications_blocked: count(applicationsSent, a => a.status === 'BLOCKED_REQUIRES_MANUAL_ACTION'),\n  responses_received: count(statusChanges, a => a.response_type && a.response_type !== 'none'),\n  interviews: count(statusChanges, a => a.status === 'INTERVIEW'),\n  rejections: count(statusChanges, a => a.status === 'REJECTED'),\n  technical_tests: count(statusChanges, a => a.status === 'TECHNICAL_TEST'),\n  avg_score: analyzer.length ? Math.round(analyzer.reduce((s, a) => s + (a.score || 0), 0) / analyzer.length) : 0,\n  top_jobs: topJobs\n};\n\nreturn [{ json: { report_date: new Date().toISOString().slice(0, 10), ...metrics } }];"
      },
      "id": "compute_daily_metrics",
      "name": "Compute_Daily_Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 180]
    },
    {
      "parameters": {
        "jsCode": "const m = $json;\nconst esc = (v) => String(v || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = (m.top_jobs || []).map(j => `<tr><td>${esc(j.company)}</td><td>${esc(j.title)}</td><td>${esc(j.location)}</td><td>${esc(j.work_mode)}</td><td>${j.salary_min || ''}-${j.salary_max || ''} ${esc(j.salary_currency)}</td><td>${j.overall_score}</td><td>${j.ats_score || ''}</td><td>${esc(j.interview_probability_label || '')}</td><td>${esc(j.classification)}</td><td><a href=\"${esc(j.url)}\">Lien</a></td></tr>`).join('');\n\nconst html = `<h1>JOB SEARCH REPORT - ${m.report_date}</h1>\n<ul>\n<li>OFFRES TROUVÉES: ${m.jobs_found}</li>\n<li>OFFRES NOUVELLES: ${m.jobs_new}</li>\n<li>DOUBLONS: ${m.jobs_duplicate}</li>\n<li>OFFRES ANALYSÉES: ${m.jobs_analyzed}</li>\n<li>OFFRES >=80: ${m.jobs_score_80plus}</li>\n<li>OFFRES 70-79: ${m.jobs_score_70_79}</li>\n<li>OFFRES 60-69: ${m.jobs_score_60_69}</li>\n<li>OFFRES REJETÉES: ${m.jobs_rejected}</li>\n<li>CV GÉNÉRÉS: ${m.cvs_generated}</li>\n<li>CANDIDATURES ENVOYÉES: ${m.applications_sent}</li>\n<li>CANDIDATURES BLOQUÉES: ${m.applications_blocked}</li>\n<li>RÉPONSES REÇUES: ${m.responses_received}</li>\n<li>ENTRETIENS: ${m.interviews}</li>\n<li>REFUS: ${m.rejections}</li>\n<li>TESTS TECHNIQUES: ${m.technical_tests}</li>\n<li>SCORE MOYEN: ${m.avg_score}</li>\n</ul>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\n<tr><th>Entreprise</th><th>Poste</th><th>Localisation</th><th>Remote/Hybrid</th><th>Salaire</th><th>Score</th><th>ATS</th><th>Chance entretien</th><th>Statut</th><th>URL</th></tr>\n${rows}\n</table>`;\n\nreturn [{ json: { ...m, report_html: html } }];"
      },
      "id": "render_report_html",
      "name": "Render_Report_HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 180]
