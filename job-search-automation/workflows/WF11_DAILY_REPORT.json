    {
      "parameters": {
        "operation": "search",
        "base": { "__rl": true, "value": "={{ $vars.AIRTABLE_BASE_ID }}", "mode": "id" },
        "table": { "__rl": true, "value": "Jobs", "mode": "list", "cachedResultName": "Jobs" },
        "filterByFormula": "AND(OR({classification}='PRIORITY',{classification}='APPLY'), IS_SAME({updated_at}, TODAY(), 'day'))",
        "returnAll": true,
        "options": {}
      },
      "id": "get_top_jobs_today",
      "name": "Get_Top_Jobs_Today",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [0, 580],
      "credentials": { "airtableTokenApi": { "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL", "name": "Airtable Job Search PAT" } }
