    {
      "parameters": {
        "jsCode": "const job = $('Build_CV_Filename').first().json;\nconst text = (job.description || '').toLowerCase();\nconst coverLetterRequired = text.includes('cover letter') || text.includes('lettre de motivation') || text.includes('letter of motivation') || text.includes('motivation letter');\nreturn [{ json: { ...job, cv_onedrive_path: $json.webUrl || $json.id, cover_letter_required: coverLetterRequired } }];"
      },
      "id": "determine_cover_letter_required",
      "name": "Determine_Cover_Letter_Required",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 60]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond_cl_required",
              "leftValue": "={{ $json.cover_letter_required }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_cover_letter_required",
      "name": "IF_Cover_Letter_Required",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1640, 60]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst systemPrompt = `Tu es un rédacteur de lettre de motivation pour une candidature en cybersécurité. Personnalise: entreprise, poste, principales exigences, compétences pertinentes RÉELLEMENT possédées (fournies), motivation professionnelle. N'invente AUCUNE information absente du CV maître ou de la recherche entreprise fournie. Longueur: 250-350 mots. Réponds UNIQUEMENT en JSON: {\\\"cover_letter_text\\\": string}.`;\nconst userMessage = JSON.stringify({ company: j.company, title: j.title, job_description: j.description, cv_sections: j.cv_optimization.cv_sections, company_research: j.company_research || {} });\nreturn [{ json: { ...j, cl_system_prompt: systemPrompt, cl_user_message: userMessage } }];"
      },
      "id": "build_cover_letter_request",
      "name": "Build_Cover_Letter_Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $vars.CLAUDE_MODEL || 'claude-sonnet-5', max_tokens: 1200, system: $json.cl_system_prompt, messages: [{ role: 'user', content: $json.cl_user_message }] }) }}",
        "options": {}
      },
      "id": "call_claude_cover_letter",
      "name": "Call_Claude_Cover_Letter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2120, -80],
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const body = item.json;\n  const job = $('Build_Cover_Letter_Request').first().json;\n  let text = '';\n  try {\n    const textBlock = (body.content || []).find(c => c.type === 'text');\n    const parsed = JSON.parse(textBlock ? textBlock.text : '{}');\n    text = parsed.cover_letter_text || textBlock?.text || '';\n  } catch (e) { text = (body.content && body.content[0] && body.content[0].text) || ''; }\n  return { json: { ...job, cover_letter_text: text } };\n});"
      },
      "id": "parse_cover_letter_response",
      "name": "Parse_Cover_Letter_Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2360, -80]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst esc = (v) => String(v || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst paragraphs = (j.cover_letter_text || '').split(/\\n+/).map(p => `<p>${esc(p)}</p>`).join('');\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><style>body{font-family:Calibri,Arial,sans-serif;font-size:11pt;margin:40px;line-height:1.5;}</style></head><body>${paragraphs}</body></html>`;\nreturn [{ json: { ...j, cl_html: html } }];"
      },
