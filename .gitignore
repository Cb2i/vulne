backend/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Node / frontend ──
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ── OS / editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

