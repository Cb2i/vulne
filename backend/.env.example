# Copy this file to backend/.env and adjust values for your environment.
# All variables are optional; sensible defaults are used otherwise (see app/core/config.py).

# --- Database ---
# Default: local SQLite file at <project_root>/data/vulnassist.db
# VULNASSIST_DATABASE_URL=sqlite:///../data/vulnassist.db
#
# To use PostgreSQL instead (optional, not required for V1):
# VULNASSIST_DATABASE_URL=postgresql+psycopg2://vulnassist:password@localhost:5432/vulnassist

# --- Security ---
# IMPORTANT: generate a real random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
VULNASSIST_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

VULNASSIST_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Default admin bootstrap (used only by `python -m app.seed` on first run) ---
VULNASSIST_DEFAULT_ADMIN_EMAIL=admin@vulnassist.internal
VULNASSIST_DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- CORS (only needed when running `npm run dev` against a separately-hosted backend) ---
# VULNASSIST_CORS_ORIGINS=["http://localhost:5173"]
